{
  "entire": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "where.exe entire >nul 2>nul & if errorlevel 1 (ver>nul) else (entire hooks antigravity pre-tool-use)"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "where.exe entire >nul 2>nul & if errorlevel 1 (ver>nul) else (entire hooks antigravity pre-invocation)"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "where.exe entire >nul 2>nul & if errorlevel 1 (ver>nul) else (entire hooks antigravity stop)",
        "timeout": 300
      }
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "entire-session-start",
            "type": "command",
            "command": "entire hooks antigravity session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "entire-session-end",
            "type": "command",
            "command": "entire hooks antigravity session-end"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "hooksConfig": {
    "enabled": true
  }
}
